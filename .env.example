# Supabase (browser-safe values only)
# Create a project at https://supabase.com/dashboard, then copy the Project URL
# and the publishable key from Project Settings → API Keys.
# The legacy anon key also works in this variable until you rotate to a publishable key.
# Never put the service-role or secret key in this file or in any NEXT_PUBLIC_ variable.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
