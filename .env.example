# Supabase (browser-safe values only)
# Create a project at https://supabase.com/dashboard, then copy the Project URL
# and the publishable key from Project Settings → API Keys.
# The legacy anon key also works in this variable until you rotate to a publishable key.
# Never put the service-role or secret key in this file or in any NEXT_PUBLIC_ variable.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set to off to keep the original manual capture checklist with no live guidance.
NEXT_PUBLIC_SMART_CAPTURE=on
# Set to on to offer the presentation background estimate. It stays off until then.
NEXT_PUBLIC_SEGMENTATION=off
# Optional. Server only. Never prefix with NEXT_PUBLIC_.
# Free models are tried first. OPENROUTER_FALLBACK_MODEL is used only after they fail.
# OPENROUTER_API_KEY=
# OPENROUTER_FALLBACK_MODEL=
